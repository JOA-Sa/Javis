PORT=3000
# Gere uma chave aleatória forte antes de usar o painel/API.
API_KEY=
PIRATA_URL=https://yts.mx

# ─── Streamings que você assina (separados por vírgula) ───
# Opções: netflix, prime, max, disney, apple, globoplay, paramount
MEUS_STREAMINGS=netflix,prime,max,disney

# ─── Inteligência Artificial & Áudio (Google Gemini Gratuito) ──
# Obtenha em: https://aistudio.google.com/app/apikey
# Permite entender áudios de voz do WhatsApp e linguagem natural
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-3.8-flash

# ─── Samsung Crystal 55" (SmartThings) ───────────────────
# 1. Gere um token em: https://account.smartthings.com/tokens
#    (permissões: Devices - List all + Control all)
# 2. Rode: npm run setup:smartthings  para descobrir o ID da TV
SMARTTHINGS_TOKEN=seu-token-aqui
SMARTTHINGS_TV_DEVICE_ID=id-da-sua-tv-aqui
SMARTTHINGS_TV_HDMI_INPUT=HDMI1

# ─── Volume automático por modo ───────────────────────────
# Volume da TV (0-100) que será definido ao ativar cada modo
TV_VOLUME_GAMING=40
TV_VOLUME_PIRATA=30
TV_VOLUME_NOTURNO=12

# Volume do PC (0-100) no modo noturno
PC_VOLUME_NOTURNO=20
